{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure Debug",
      "type": "shell",
      "command": "cmake --preset fm33l0xxd-debug-local",
      "problemMatcher": []
    },
    {
      "label": "Build Debug",
      "type": "shell",
      "command": "cmake --build --preset fm33l0xxd-debug-local",
      "dependsOn": "Configure Debug",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Flash via J-Link",
      "type": "shell",
      "command": "pyocd flash -t fm33l0XXd -f 1M ${workspaceFolder}/build/Debug/FM33L0XXD_App.elf",
      "dependsOn": "Build Debug",
      "problemMatcher": []
    }
  ]
}